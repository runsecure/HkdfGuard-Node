{
  "name": "@runsecure/hkdfguard-cache",
  "version": "0.1.0",
  "description": "Default ProtectedCache (a single, already-built DataEncryptionKey backing a highly concurrent encrypted-value cache) and ProtectedCacheCollection, an ordered aggregate of read-only cache sources.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@runsecure/hkdfguard-abstractions": "^0.1.0",
    "@runsecure/hkdfguard-diagnostics": "^0.1.0"
  },
  "devDependencies": {
    "@runsecure/hkdfguard-cryptosession-aesgcm256": "^0.1.0",
    "@runsecure/hkdfguard-dataencryptionkey": "^0.1.0"
  }
}
