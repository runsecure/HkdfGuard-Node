{
  "name": "@runsecure/hkdfguard-diagnostics",
  "version": "0.1.0",
  "description": "Shared OpenTelemetry tracing/metrics and logging surface for HkdfGuard's Node components.",
  "type": "module",
  "main": "./dist/index.js",
